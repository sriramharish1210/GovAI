# GovAI frontend environment variables (copy to .env.local and edit; never commit real values)

# Optional. Google OAuth client ID (public, safe to expose in the browser).
# When set, the sign-in page shows "Continue with Google", which sends Google's ID token
# to the backend's existing POST /api/v1/auth/google endpoint.
# It must be the same client ID the backend verifies against (GOOGLE_CLIENT_ID).
# Leave empty in local development: the dev-only demo sign-in is used instead.
VITE_GOOGLE_CLIENT_ID=
