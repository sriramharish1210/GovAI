# Database configuration (SQLite for development)
DATABASE_URL="file:./dev.db"

# Server Port
PORT=5000

# CORS Configuration (Set to your frontend URL)
FRONTEND_URL="http://localhost:5173"

# JWT Token Secret (Choose a strong random string)
AUTH_SECRET="your_jwt_secret_must_be_long_and_secure_key"

# AI Mode (gemini | mock)
AI_MODE="mock"

# Google Gemini API Key (Required if AI_MODE=gemini)
GEMINI_API_KEY=""

# Gemini Model Identifier (Defaults to gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# Google OAuth Configuration (Required for Google login in production)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Rate Limit Configurations
# Number of requests allowed in windowMs (e.g. 15 mins)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_GENERAL=100

# Stricter rate limits for expensive operations (Chatbot, Recommendations, PDF Report, explanations)
RATE_LIMIT_MAX_AI=20

# Email Notification Provider API Key (Required for production, e.g. SendGrid / Resend)
EMAIL_PROVIDER_KEY="your_email_provider_api_key"
EMAIL_FROM="no-reply@govai.gov.in"
